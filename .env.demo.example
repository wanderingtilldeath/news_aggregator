# Free demo: a serve-only web service plus a scheduled crawl job, sharing one
# Neon database. Never commit real values; the real file is .env (gitignored).
#
# DATABASE_URL: use Neon's DIRECT endpoint (host without "-pooler"). The pgx
# statement cache and goose's advisory lock fail behind transaction pooling.
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
USER_AGENT=CrawlerX/1.0 (+https://github.com/YOU/news-aggregator)

# --- web service (Render): serves the news page (/) and the read-only API ---------
# Render routes to port 10000 by default.
LISTEN_ADDR=:10000
WORKERS=0
READ_ONLY=true
IMAGE_CACHE_MB=24
GOMEMLIMIT=180MiB
LOG_FORMAT=json
# Leave SOURCES unset here: a web box with SOURCES would start the daily crawl.

# --- crawl job (GitHub Actions, see .github/workflows/crawl.yml) -------------
# Set in the workflow, listed here for reference.
# WORKERS=2
# SOURCES=sources.json
# RUN_ON_START=true
# TIMEZONE=UTC
# MAX_SITES=6
# IMAGE_CACHE_MB=1
# GOMEMLIMIT=350MiB
# SUMMARY_PROVIDER=extractive        # or auto with GEMINI_API_KEY (repo secret)
# SUMMARY_WINDOW_DAYS=30             # use 7 when summarising with Gemini
# SUMMARY_BATCH=12
