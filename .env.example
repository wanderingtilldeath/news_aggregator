# Copy to /etc/crawlerx.env on the server (systemd EnvironmentFile), or `set -a; . ./.env`.
DATABASE_URL=postgres://crawlerx:CHANGE_ME@127.0.0.1:5432/crawlerx?sslmode=disable
LISTEN_ADDR=127.0.0.1:8080
USER_AGENT=CrawlerX/1.0 (+https://example.com/contact)
# Small server: fewer workers and a small image cache.
WORKERS=4
IMAGE_CACHE_MB=32

# Free key from https://aistudio.google.com/apikey. Without it, digest gists
# fall back to the first sentences of each article.
GEMINI_API_KEY=

# Optional. Defaults: gemini-3.5-flash-lite, run at 06:00 Asia/Kolkata.
# SUMMARY_MODEL=gemini-3.5-flash-lite
# DIGEST_AT=06:00
# TIMEZONE=Asia/Kolkata

# The daily digest crawls the sites in sources.json (always including Indian
# Express, plus developer blogs and news sites). Each site adds crawl time
# and Gemini calls. To add one, move an entry from catalog/*.json into sources.json.
# Optional cap on distinct sites (startup fails above it); 0 = no limit.
# MAX_SITES=0
# SOURCES=/etc/crawlerx/sources.json
