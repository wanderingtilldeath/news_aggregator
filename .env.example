# Copy to /etc/crawlerx.env on the server (systemd EnvironmentFile), or `set -a; . ./.env`.
DATABASE_URL=postgres://crawlerx:CHANGE_ME@127.0.0.1:5432/crawlerx?sslmode=disable
LISTEN_ADDR=127.0.0.1:8080
USER_AGENT=CrawlerX/1.0 (+https://example.com/contact)
# Small server: fewer workers and a small image cache.
WORKERS=4
IMAGE_CACHE_MB=32

# Free key from https://aistudio.google.com/apikey. Without it, digest gists
# fall back to the first sentences of each article.
GEMINI_API_KEY=

# Optional. Defaults: gemini-3.5-flash-lite, run at 06:00 Asia/Kolkata.
# SUMMARY_MODEL=gemini-3.5-flash-lite
# DIGEST_AT=06:00
# TIMEZONE=Asia/Kolkata

# The daily digest crawls the sites in sources.json (always including Indian
# Express, plus developer blogs and news sites). Each site adds crawl time
# and Gemini calls. To add one, move an entry from catalog/*.json into sources.json.
# Optional cap on distinct sites (startup fails above it); 0 = no limit.
# MAX_SITES=0
# SOURCES=/etc/crawlerx/sources.json

# Email. "log" prints each mail and sends nothing. For "brevo": free plan, 300 mails a day,
# API key from https://app.brevo.com (SMTP & API > API keys), and MAIL_FROM must be an address on
# a domain you verified in Brevo (SPF/DKIM), or mail goes to spam or is rejected.
# Brevo is called over HTTPS because free Render web services block SMTP ports.
MAIL_PROVIDER=log
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Postpaper
# Public address of the web frontend (Vercel); links in emails point to it.
WEB_BASE_URL=http://localhost:3000
# Used by cmd/senddigest (the daily email). PUBLIC_API_URL is where the one-click
# unsubscribe header POSTs, i.e. the Cloudflare Worker address; MAIL_FOOTER is an extra
# line in every mail (your name and postal address where the law asks for one).
PUBLIC_API_URL=
MAIL_FOOTER=
# Sites that asked not to be crawled or shown (comma separated hosts, e.g. www.example.com). The
# crawl job skips them and deletes their stored pages; set it as a GitHub variable too.
BLOCKED_HOSTS=
# Pro: the webhook secret of your Razorpay account (Settings > Webhooks) and how many days one
# payment buys. Without the secret POST /billing/razorpay is not served.
RAZORPAY_WEBHOOK_SECRET=
PRO_DAYS=31
# Optional: one labelled sponsor line in every daily email (both needed, link must be http(s)).
MAIL_SPONSOR_TEXT=
MAIL_SPONSOR_URL=

# Telegram channels (free): create a bot with @BotFather, make it an administrator of a
# public channel per edition, then set the token (secret) and the channel names. Leave a
# chat empty to post nothing for that edition. senddigest posts one one-minute edition
# per channel per day.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_UPSC=
TELEGRAM_CHAT_ENGINEERING=

# Summaries, "why it matters" lines, topic tags, importance scores and the daily quiz all
# use Gemini (free key from https://aistudio.google.com/apikey). Without it the gists are
# extractive and none of the others is produced.
