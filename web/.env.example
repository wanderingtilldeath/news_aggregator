# Base URL of the Cloudflare Worker (or a local crawlerx) that serves /digest and /img.
API_BASE_URL=http://localhost:8080

# Optional. Read when the site is built, so redeploy after changing them.
# Public address of the site: share links, the sitemap and the RSS feed.
SITE_URL=https://www.postpaper.in
# One labelled sponsor line above the footer (both text and an http(s) link are needed).
SPONSOR_TEXT=
SPONSOR_URL=
SPONSOR_LABEL=Sponsored
# Cloudflare Web Analytics token (cookie-free page counts); the beacon loads only when set.
CF_ANALYTICS_TOKEN=
